{
  "name": "hirelens",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, glass-box hiring intelligence. Rank candidates against a job with evidence-linked scores, rubric transparency, and built-in bias auditing.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhay-yemekar/hirelens.git"
  },
  "homepage": "https://github.com/abhay-yemekar/hirelens#readme",
  "bugs": "https://github.com/abhay-yemekar/hirelens/issues",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "turbo": "^2.10.12"
  }
}
