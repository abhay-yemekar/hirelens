# HireLens web app (copy to .env.local — never commit .env.local)

# Base URL of the HireLens API (better-auth cookies are scoped to this origin).
# Local dev default: the API on :4000. The API's CORS_ORIGINS must include
# the origin this app runs on (default http://localhost:3000).
# Single-origin deployment (Vercel): leave EMPTY — the API is mounted in
# this app at /api/*. Values are scheme-normalized (a missing https://
# is added), but always prefer the full origin.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth docs (better-auth client) must know the API origin too.
# Optional — defaults to NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:4000

# --- Social sign-in (optional) ---
# The SERVER side is controlled by GOOGLE_CLIENT_ID / GITHUB_CLIENT_ID (+
# _SECRET) in the root .env / packages/db env — a provider without both is
# disabled server-side. These NEXT_PUBLIC flags tell the sign-in UI which
# buttons to render for this deployment. Set to "true" only when the
# matching server credentials exist.
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
# NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false

# --- Product analytics (optional; strict no-op without the key) ---
# PostHog. Autocapture is OFF — only explicit product events are sent
# (scoring kickoff, review decisions). Leave empty to disable entirely.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
