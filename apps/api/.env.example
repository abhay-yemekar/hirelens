# CandidLens API (apps/api) — copy to .env (never commit .env)
# The API loads this file from its own directory via dotenv.

# Postgres connection (local dev: docker compose up -d)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hirelens

# HTTP port
PORT=4000

# --- LLM (optional) ---
# Set BOTH provider and model to enable rubric derivation + scoring.
# Provider: google | anthropic | groq | openrouter | ollama
# Model must be a real id for the provider (e.g. list via the provider's
# models API). For Google, stable ids look like `gemini-2.5-flash`.
# Omit entirely to run with LLM features disabled (derive/score return 503).
# A partial config fails loudly at boot.
# Settings used to be named HIRELENS_*; those names still work, and the
# CANDIDLENS_* name wins when both are set.
# CANDIDLENS_LLM_PROVIDER=google
# CANDIDLENS_LLM_MODEL=gemini-2.5-flash
# CANDIDLENS_LLM_API_KEY=
# Required for ollama (its OpenAI-compatible endpoint), optional elsewhere:
# CANDIDLENS_LLM_BASE_URL=http://localhost:11434/v1

# Search by meaning uses Google embeddings and sends them resume text. They
# use this Google AI key, or else CANDIDLENS_LLM_API_KEY when the provider is
# google (or CANDIDLENS_LLM_GOOGLE_API_KEY). Without a Google key, search
# matches keywords and nothing goes to Google.
# CANDIDLENS_EMBEDDING_API_KEY=

# --- CORS ---
# Comma-separated origins allowed to call the API with credentials
# (the web app runs on one of these in dev).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Observability (all optional; the app runs fully without these) ---
# Structured logs: pino, JSON in production, pretty lines in dev.
# LOG_LEVEL=info

# Sentry error tracking. Set the DSN to enable; without it errors are
# only logged (no network calls, no SDK side effects).
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Langfuse LLM tracing. Set BOTH keys to trace every scoring call
# (prompt hashes, token usage, latency, per-criterion scores).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Release identifier attached to Sentry events and Langfuse traces
# (CI sets this to the git sha on deploy).
# RELEASE=
