{
  "name": "@hirelens/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./embed": {
      "types": "./src/vercel.ts",
      "default": "../web/.hirelens-api/server.mjs"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build:embed": "node scripts/build-embed.mjs",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hirelens/core": "workspace:*",
    "@hirelens/db": "workspace:*",
    "@hirelens/orchestrator": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@sentry/node": "^10.74.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "langfuse": "^3.39.2",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hirelens/config": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
}
