# HireLens database + auth (packages/db)
# Local dev: docker compose up -d postgres (port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hirelens

# Better Auth (packages/db/auth.config.ts)
# Generate a real secret for anything beyond local dev: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-secret-do-not-use-in-production-0123456789abcdef

# Optional social login (leave empty to disable the provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
