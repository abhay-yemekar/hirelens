# HireLens root environment (copy to .env - never commit .env)

# --- Database (packages/db + apps) ---
# Local dev: docker compose up -d postgres (port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hirelens

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32+char-random-secret
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth providers (optional; leave empty to disable) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
