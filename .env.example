# HireLens root environment (copy to .env - never commit .env)
# Note: packages with their own .env (e.g. packages/db) load it from their own directory.

# --- Database (packages/db + apps) ---
# Local dev: docker compose up -d postgres (port 5433)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/hirelens

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32+char-random-secret
BETTER_AUTH_URL=http://localhost:4000

# --- LLM provider (optional; enable scoring/rubric drafting) ---
# Settings used to be named HIRELENS_*; those names still work, and the
# CANDIDLENS_* name wins when both are set.
# Providers: google | anthropic | groq | openrouter | mistral | cerebras | ollama
# Without these, the app boots fine and LLM routes return 503 llm_not_configured.
# CANDIDLENS_LLM_PROVIDER=google
# CANDIDLENS_LLM_MODEL=gemini-2.5-flash
# CANDIDLENS_LLM_API_KEY=

# --- LLM failover chain (optional) ---
# Comma-separated providers tried ONLY when the primary is overloaded or
# rate-limited. EVERY fallback MUST have its own model id — a provider
# never inherits another provider's model name (e.g. Groq cannot serve
# "gemini-2.5-flash"); config validation fails at boot otherwise.
# Model ids are provider-specific: list a provider's active models via its
# models endpoint (Groq: GET https://api.groq.com/openai/v1/models with your
# Bearer key). Groq models that support strict JSON schema structured
# outputs include openai/gpt-oss-120b and openai/gpt-oss-20b.
# CANDIDLENS_LLM_FALLBACKS=groq
# CANDIDLENS_LLM_GROQ_API_KEY=
# CANDIDLENS_LLM_GROQ_MODEL=openai/gpt-oss-120b

# --- LLM retry deadline (optional) ---
# Overall retry/failover budget in ms (default 120000, cap 600000) so the
# retry ladder can never outlive a serverless function limit.
# CANDIDLENS_LLM_DEADLINE_MS=120000

# --- OAuth providers (optional; leave empty to disable) ---
# When enabled, also set the matching NEXT_PUBLIC_*_OAUTH_ENABLED=true in
# apps/web/.env.local (or compose env) so the sign-in UI shows the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- One-command self-host (docker compose up) ---
# Required by the compose stack (the api service refuses to boot without it).
# Generate with: openssl rand -base64 32
# BETTER_AUTH_SECRET is already listed above; the variables below are optional
# compose conveniences (defaults shown).
# BETTER_AUTH_URL=http://localhost:4000
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:4000
