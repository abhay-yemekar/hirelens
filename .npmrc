# Enforce the toolchain declared in package.json:
#   - "engines": { "node": ">=20" }  → hard error instead of a warning
#   - "packageManager": "pnpm@11.7.0" (enforced via corepack)
# This is the Node equivalent of failing fast on the wrong interpreter
# version: no half-working installs on unsupported Node versions.
engine-strict=true
